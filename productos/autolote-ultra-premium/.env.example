# Copie este archivo como .env (nunca lo suba al repositorio).
NODE_ENV=development
PORT=3001
# URL pública del sitio (sin barra final). En producción: https://su-dominio
PUBLIC_URL=http://localhost:5173

# Base de datos. Local: sqlite. Hostinger: mysql (host 127.0.0.1, puerto 3306).
DB_CLIENT=sqlite
SQLITE_FILE=./data/autolote.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Secreto largo y aleatorio para firmar/derivar tokens (64+ caracteres).
APP_SECRET=
# Carpeta de archivos subidos (fuera de la carpeta pública del build).
UPLOAD_DIR=./uploads
# Tamaño máximo por imagen en MB
UPLOAD_MAX_MB=8

# Solo para crear la PRIMERA cuenta propietaria en Hostinger (sin terminal).
# Úselas una vez, inicie la app, y luego bórrelas de las variables de entorno.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
